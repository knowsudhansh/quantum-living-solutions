# Required for database-backed features in production and development; server-only.
# DATABASE_URL: application connection. DIRECT_URL: required by Prisma CLI/schema tooling.
# Build/generation checks can use placeholders; no production DB is needed to compile.
DATABASE_URL=
DIRECT_URL=

# Required for admin authentication in production/development; server-only, at least 32 characters.
# Preserve the existing secret during ownership migration to preserve sessions.
NEXTAUTH_SECRET=
# Required operationally for absolute production email links; optional for startup.
# Canonical origin also used for build/render metadata and runtime origin checks.
# Read on the server; the origin itself is intentionally public (never credentials).
# Configure the appropriate local origin for development.
NEXTAUTH_URL=

# Required for production public media uploads; server-only secret.
# Development media uploads use local public/uploads instead.
BLOB_READ_WRITE_TOKEN=

# Required for private resumes in every environment: choose one auth strategy.
# Non-secret store identifier, consumed server-side with Vercel-issued OIDC.
# Store-ID authentication takes precedence when both strategies are configured.
RESUME_BLOB_STORE_ID=
# Alternative server-only token for the existing PRIVATE resume store.
RESUME_BLOB_READ_WRITE_TOKEN=
# SDK-consumed, server-only short-lived token for the store-ID strategy.
# Automatically supplied on Vercel; do not copy deployment tokens between accounts.
VERCEL_OIDC_TOKEN=

# Optional for startup; required for actual email delivery. Server-only secret.
RESEND_API_KEY=

# Optional development/CI Playwright base URL; not read by application components.
# Public non-secret test configuration despite its NEXT_PUBLIC prefix.
NEXT_PUBLIC_APP_URL=

# Optional Google Analytics 4 Measurement ID for the Google tag (gtag.js), e.g. G-XXXXXXXXXX.
# Read by src/components/GoogleAnalytics.tsx and by src/proxy.ts, which widens the CSP to the
# Google tag/collection origins only while this is set on a public route.
# Client-visible by design and NOT a secret: NEXT_PUBLIC_ values are inlined into the browser
# bundle. Never place Google API keys, OAuth secrets or a GA Measurement Protocol api_secret
# behind a NEXT_PUBLIC_ prefix. Leave blank to disable analytics entirely (local/CI/test).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
